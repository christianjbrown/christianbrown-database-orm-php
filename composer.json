{
    "name": "christianjbrown/christianbrown-database-orm",
    "description": "Shared Doctrine ORM entities and plumbing for the christianbrown Cloud SQL database (rotating tokens plus SmartThings / Met Office climate history).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Christian Brown"
        }
    ],
    "require": {
        "php": "^8.5",
        "christianjbrown/key-value-store": "^1.0",
        "doctrine/dbal": "^4.4.3",
        "doctrine/orm": "^3.6.7",
        "symfony/cache": "^8.0",
        "symfony/console": "^8.0"
    },
    "require-dev": {
        "christianjbrown/code-quality-scripts": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "ChristianBrown\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChristianBrown\\Database\\Tests\\": "tests/"
        }
    },
    "config": {
        "bin-dir": "bin",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "db-update-dry-run": [
            "(export $(grep -v '^#' .local.env | xargs) && php ./doctrine orm:schema-tool:update --dump-sql)"
        ],
        "db-update-force": [
            "(export $(grep -v '^#' .local.env | xargs) && php ./doctrine orm:schema-tool:update --complete --force --dump-sql)"
        ],
        "test": [
            "clear && XDEBUG_MODE=coverage ./bin/phpunit -d memory_limit=512M && open ./.phpunit.cache/code-coverage-html/index.html"
        ],
        "stan": [
            "clear && ./bin/phpstan analyse"
        ],
        "check-style": [
            "clear && ./bin/php-cs ./src ./tests"
        ],
        "check-style-diff": [
            "clear && ./bin/php-cs-diff"
        ],
        "fix-style": [
            "clear && ./bin/php-cs-fix ./src ./tests"
        ],
        "fix-style-diff": [
            "clear && ./bin/php-cs-fix-diff"
        ]
    }
}
